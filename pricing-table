<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pricing Table</title>
<style>
  body { background: #f0f4f8; font-family: Arial; text-align: center; margin: 0; }
  .pricing {
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 50px;
    flex-wrap: wrap;
  }
  .plan {
    background: white;
    width: 280px;
    border-radius: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    transition: 0.3s;
    padding: 20px;
  }
  .plan:hover {
    background: #e3f2fd;
    transform: scale(1.05);
  }
  .popular {
    border: 2px solid #2196f3;
  }
  button {
    background: #2196f3;
    border: none;
    padding: 10px 20px;
    color: white;
    border-radius: 5px;
  }
</style>
</head>
<body>
  <h1>Our Pricing Plans</h1>
  <div class="pricing">
    <div class="plan">
      <h3>Basic</h3><p>$10/month</p>
      <ul><li>1 User</li><li>5GB Storage</li></ul>
      <button>Buy Now</button>
    </div>
    <div class="plan popular">
      <h3>Standard</h3><p>$20/month</p>
      <ul><li>5 Users</li><li>50GB Storage</li></ul>
      <button>Buy Now</button>
    </div>
    <div class="plan">
      <h3>Premium</h3><p>$30/month</p>
      <ul><li>10 Users</li><li>100GB Storage</li></ul>
      <button>Buy Now</button>
    </div>
  </div>
</body>
</html>
